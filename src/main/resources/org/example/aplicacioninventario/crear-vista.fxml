<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="380.0" spacing="6.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.aplicacioninventario.CrearControlador">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="Crear nuevo equipo">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
            <VBox.margin>
                <Insets bottom="8.0" />
            </VBox.margin>
        </Label>

        <Label text="Nombre" />
        <TextField fx:id="txtNombre" />

        <Label text="Descripción" />
        <TextArea fx:id="txtDescripcion" prefRowCount="3" wrapText="true" />

        <Label text="Fecha" />
        <DatePicker fx:id="dpFecha" maxWidth="Infinity" promptText="dd/mm/aaaa" />

        <Label text="Categoría" />
        <ChoiceBox fx:id="cmbCategoria" maxWidth="Infinity" />

        <Label text="Estado" />
        <ComboBox fx:id="cmbEstado" maxWidth="Infinity" promptText="Selecciona una opción" />

        <HBox spacing="10.0">
            <VBox.margin>
                <Insets top="12.0" />
            </VBox.margin>
            <children>
                <Button fx:id="btnGuardar" defaultButton="true" maxWidth="Infinity" mnemonicParsing="false" onAction="#onGuardar"
                        style="-fx-background-color: #1a73e8; -fx-text-fill: white;" text="Guardar" HBox.hgrow="ALWAYS" />
                <Button cancelButton="true" maxWidth="Infinity" mnemonicParsing="false" onAction="#onCancelar" text="Cancelar" HBox.hgrow="ALWAYS" />
            </children>
        </HBox>
    </children>
</VBox>
